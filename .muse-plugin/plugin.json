{
  "schemaVersion": 1,
  "name": "superpowers",
  "displayName": "Superpowers",
  "version": "7.0.2",
  "description": "Core skills library for Muse: debugging, collaboration patterns, and proven techniques",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "executing-plans",
        "path": "skills/executing-plans/SKILL.md"
      },
      {
        "id": "receiving-code-review",
        "path": "skills/receiving-code-review/SKILL.md"
      },
      {
        "id": "systematic-debugging",
        "path": "skills/systematic-debugging/SKILL.md"
      },
      {
        "id": "using-superpowers",
        "path": "skills/using-superpowers/SKILL.md"
      },
      {
        "id": "verification-before-completion",
        "path": "skills/verification-before-completion/SKILL.md"
      },
      {
        "id": "writing-good-tests",
        "path": "skills/writing-good-tests/SKILL.md"
      },
      {
        "id": "writing-plans",
        "path": "skills/writing-plans/SKILL.md"
      }
    ],
    "commands": [],
    "hooks": [
      {
        "id": "session-start",
        "event": "SessionStart",
        "command": [
          "bash",
          "hooks/session-start"
        ],
        "timeoutMs": 5000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
